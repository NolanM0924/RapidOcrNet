<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="bu_kids.MainPage"
             Title="BU Kids OCR">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">
        <VerticalStackLayout Grid.Row="0" Spacing="15" Margin="0,0,0,10">
            <Label 
                Text="BU Kids OCR App" 
                FontSize="28" 
                FontAttributes="Bold" 
                HorizontalOptions="Center"/>
            
            <Button 
                x:Name="PickImageButton" 
                Text="Pick an Image"
                Clicked="OnPickImageClicked"
                HorizontalOptions="Center" />
        </VerticalStackLayout>
        
        <Grid Grid.Row="1" RowDefinitions="*,*">
            <Frame Grid.Row="0" BorderColor="Gray" Margin="0,0,0,10" Padding="10">
                <ScrollView>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Selected Image:" FontAttributes="Bold"/>
                        <Image 
                            x:Name="DisplayImage" 
                            Aspect="AspectFit"
                            HeightRequest="200"
                            HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </ScrollView>
            </Frame>
            
            <Frame Grid.Row="1" BorderColor="Gray" Padding="10">
                <ScrollView>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="OCR Results:" FontAttributes="Bold"/>
                        <Editor 
                            x:Name="ResultText" 
                            IsReadOnly="True"
                            AutoSize="TextChanges"
                            HorizontalOptions="Fill"/>
                    </VerticalStackLayout>
                </ScrollView>
            </Frame>
        </Grid>
        
        <VerticalStackLayout Grid.Row="2" Spacing="15" Margin="0,10,0,0">
            <Button 
                x:Name="ProcessButton" 
                Text="Process Image" 
                Clicked="OnProcessClicked"
                IsEnabled="False"
                HorizontalOptions="Center" />
            
            <Label 
                x:Name="StatusLabel" 
                Text="" 
                HorizontalOptions="Center" 
                FontSize="14"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
