<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LotteryTicketAppNew.ViewModels"
             x:Class="LotteryTicketAppNew.Views.MainPage"
             x:DataType="vm:MainViewModel">

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30,0" VerticalOptions="Center">

            <Label 
                Text="{Binding Title}"
                SemanticProperties.HeadingLevel="Level1"
                FontSize="32"
                HorizontalOptions="Center" />

            <Label 
                Text="{Binding StatusMessage}"
                FontSize="14"
                HorizontalOptions="Center"
                IsVisible="{Binding StatusMessage, Converter={StaticResource IsNotNull}}" />

            <Button
                x:Name="PickImageBtn"
                Text="Pick Image"
                SemanticProperties.Hint="Picks an image to scan"
                Command="{Binding PickAndUploadImageCommand}"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBool}}"
                HorizontalOptions="Center" />

            <Image
                x:Name="SelectedImage"
                Source="{Binding CurrentImage.ImagePath}"
                HeightRequest="200"
                IsVisible="{Binding CurrentImage, Converter={StaticResource IsNotNull}}"
                Aspect="AspectFit"
                HorizontalOptions="Center" />

            <Frame IsVisible="{Binding DetectedText.Count, Converter={StaticResource IsNotZero}}"
                   BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                   Padding="10"
                   Margin="5,0"
                   CornerRadius="10">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Detected Text:"
                           FontAttributes="Bold"
                           FontSize="16"
                           Margin="0,0,0,5" />
                    <CollectionView ItemsSource="{Binding DetectedText}"
                                    HeightRequest="200">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}"
                                       Margin="5,2"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">
                <Button
                    Text="Clear"
                    Command="{Binding ClearImageCommand}"
                    IsEnabled="{Binding CurrentImage, Converter={StaticResource IsNotNull}}" />
                
                <Button
                    Text="Save Results"
                    Command="{Binding SaveResultsCommand}"
                    IsVisible="{Binding DetectedText.Count, Converter={StaticResource IsNotZero}}" />

                <Button
                    Text="Diagnostics"
                    Command="{Binding ShowDiagnosticInfoCommand}"
                    BackgroundColor="Orange"
                    TextColor="White" />
            </HorizontalStackLayout>

            <ActivityIndicator 
                IsRunning="{Binding IsScanning}"
                IsVisible="{Binding IsScanning}"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage> 